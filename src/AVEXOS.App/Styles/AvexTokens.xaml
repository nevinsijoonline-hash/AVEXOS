<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AvexBgBaseColor">#141517</Color>
            <Color x:Key="AvexBgRaisedColor">#191B1E</Color>
            <Color x:Key="AvexSurface1Color">#1E2125</Color>
            <Color x:Key="AvexSurface2Color">#24282D</Color>
            <Color x:Key="AvexBorderSubtleColor">#2C3137</Color>
            <Color x:Key="AvexBorderStrongColor">#3A4048</Color>
            <Color x:Key="AvexTextPrimaryColor">#ECEDEF</Color>
            <Color x:Key="AvexTextSecondaryColor">#A2A9B4</Color>
            <Color x:Key="AvexTextTertiaryColor">#6E7681</Color>
            <Color x:Key="AvexAccentColor">#6E8BFF</Color>
            <Color x:Key="AvexAccentHoverColor">#8099FF</Color>
            <Color x:Key="AvexSuccessColor">#3FA96B</Color>
            <Color x:Key="AvexWarningColor">#D9A23A</Color>
            <Color x:Key="AvexDangerColor">#D9534F</Color>
            <SolidColorBrush x:Key="AvexBgBaseBrush" Color="{ThemeResource AvexBgBaseColor}" />
            <SolidColorBrush x:Key="AvexBgRaisedBrush" Color="{ThemeResource AvexBgRaisedColor}" />
            <SolidColorBrush x:Key="AvexSurface1Brush" Color="{ThemeResource AvexSurface1Color}" />
            <SolidColorBrush x:Key="AvexSurface2Brush" Color="{ThemeResource AvexSurface2Color}" />
            <SolidColorBrush x:Key="AvexBorderSubtleBrush" Color="{ThemeResource AvexBorderSubtleColor}" />
            <SolidColorBrush x:Key="AvexBorderStrongBrush" Color="{ThemeResource AvexBorderStrongColor}" />
            <SolidColorBrush x:Key="AvexTextPrimaryBrush" Color="{ThemeResource AvexTextPrimaryColor}" />
            <SolidColorBrush x:Key="AvexTextSecondaryBrush" Color="{ThemeResource AvexTextSecondaryColor}" />
            <SolidColorBrush x:Key="AvexTextTertiaryBrush" Color="{ThemeResource AvexTextTertiaryColor}" />
            <SolidColorBrush x:Key="AvexAccentBrush" Color="{ThemeResource AvexAccentColor}" />
            <SolidColorBrush x:Key="AvexAccentHoverBrush" Color="{ThemeResource AvexAccentHoverColor}" />
            <SolidColorBrush x:Key="AvexSuccessBrush" Color="{ThemeResource AvexSuccessColor}" />
            <SolidColorBrush x:Key="AvexWarningBrush" Color="{ThemeResource AvexWarningColor}" />
            <SolidColorBrush x:Key="AvexDangerBrush" Color="{ThemeResource AvexDangerColor}" />
            <CornerRadius x:Key="AvexControlCornerRadius">3</CornerRadius>
            <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">5</CornerRadius>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AvexBgBaseColor">#F4F5F7</Color>
            <Color x:Key="AvexBgRaisedColor">#FAFAFB</Color>
            <Color x:Key="AvexSurface1Color">#FFFFFF</Color>
            <Color x:Key="AvexSurface2Color">#EEF0F3</Color>
            <Color x:Key="AvexBorderSubtleColor">#E1E4E8</Color>
            <Color x:Key="AvexBorderStrongColor">#C9CED6</Color>
            <Color x:Key="AvexTextPrimaryColor">#1C1F23</Color>
            <Color x:Key="AvexTextSecondaryColor">#565D68</Color>
            <Color x:Key="AvexTextTertiaryColor">#7C8591</Color>
            <Color x:Key="AvexAccentColor">#2F5BEA</Color>
            <Color x:Key="AvexAccentHoverColor">#1F49D6</Color>
            <Color x:Key="AvexSuccessColor">#2E8B57</Color>
            <Color x:Key="AvexWarningColor">#B7791F</Color>
            <Color x:Key="AvexDangerColor">#C0392B</Color>
            <SolidColorBrush x:Key="AvexBgBaseBrush" Color="{ThemeResource AvexBgBaseColor}" />
            <SolidColorBrush x:Key="AvexBgRaisedBrush" Color="{ThemeResource AvexBgRaisedColor}" />
            <SolidColorBrush x:Key="AvexSurface1Brush" Color="{ThemeResource AvexSurface1Color}" />
            <SolidColorBrush x:Key="AvexSurface2Brush" Color="{ThemeResource AvexSurface2Color}" />
            <SolidColorBrush x:Key="AvexBorderSubtleBrush" Color="{ThemeResource AvexBorderSubtleColor}" />
            <SolidColorBrush x:Key="AvexBorderStrongBrush" Color="{ThemeResource AvexBorderStrongColor}" />
            <SolidColorBrush x:Key="AvexTextPrimaryBrush" Color="{ThemeResource AvexTextPrimaryColor}" />
            <SolidColorBrush x:Key="AvexTextSecondaryBrush" Color="{ThemeResource AvexTextSecondaryColor}" />
            <SolidColorBrush x:Key="AvexTextTertiaryBrush" Color="{ThemeResource AvexTextTertiaryColor}" />
            <SolidColorBrush x:Key="AvexAccentBrush" Color="{ThemeResource AvexAccentColor}" />
            <SolidColorBrush x:Key="AvexAccentHoverBrush" Color="{ThemeResource AvexAccentHoverColor}" />
            <SolidColorBrush x:Key="AvexSuccessBrush" Color="{ThemeResource AvexSuccessColor}" />
            <SolidColorBrush x:Key="AvexWarningBrush" Color="{ThemeResource AvexWarningColor}" />
            <SolidColorBrush x:Key="AvexDangerBrush" Color="{ThemeResource AvexDangerColor}" />
            <CornerRadius x:Key="AvexControlCornerRadius">3</CornerRadius>
            <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">5</CornerRadius>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="AvexFontFamily">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>

    <!-- Spacing tokens -->
    <x:Double x:Key="AvexSpaceXxs">4</x:Double>
    <x:Double x:Key="AvexSpaceXs">8</x:Double>
    <x:Double x:Key="AvexSpaceSm">12</x:Double>
    <x:Double x:Key="AvexSpaceMd">16</x:Double>
    <x:Double x:Key="AvexSpaceLg">24</x:Double>
    <x:Double x:Key="AvexSpaceXl">32</x:Double>
    <x:Double x:Key="AvexSpaceXxl">48</x:Double>

    <!-- Typography size tokens -->
    <x:Double x:Key="AvexTypeCaption">11</x:Double>
    <x:Double x:Key="AvexTypeBody">13</x:Double>
    <x:Double x:Key="AvexTypeBodyLg">14</x:Double>
    <x:Double x:Key="AvexTypeH3">16</x:Double>
    <x:Double x:Key="AvexTypeH2">20</x:Double>
    <x:Double x:Key="AvexTypeH1">24</x:Double>
    <x:Double x:Key="AvexTypeDisplay">28</x:Double>

    <!-- Card corner radius -->
    <CornerRadius x:Key="AvexCardCornerRadius">8</CornerRadius>
</ResourceDictionary>
