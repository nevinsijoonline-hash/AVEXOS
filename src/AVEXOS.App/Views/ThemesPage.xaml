<Page
    x:Class="AVEXOS.App.ThemesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="{StaticResource AvexSpaceLg}">
        <StackPanel Spacing="{StaticResource AvexSpaceLg}">

            <!-- Page Header -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceMd}">
                <Image Source="ms-appx:///assets/avex-logo.jpeg" Width="48" Height="48" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Themes" FontSize="{StaticResource AvexTypeH2}" FontWeight="SemiBold"
                               Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                    <TextBlock Text="Manage and apply visual themes to the control center" FontSize="{StaticResource AvexTypeBody}"
                               Foreground="{ThemeResource AvexTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Import / Export Section -->
            <Border Background="{ThemeResource AvexSurface1Brush}"
                    BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AvexCardCornerRadius}"
                    Padding="{StaticResource AvexSpaceLg}">
                <StackPanel Spacing="{StaticResource AvexSpaceMd}">
                    <TextBlock Text="Import / Export" FontSize="{StaticResource AvexTypeH3}" FontWeight="SemiBold"
                               Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceSm}">
                        <Button x:Name="ImportThemeButton" Content="Import Theme" Click="ImportThemeButton_Click" />
                        <Button x:Name="ExportThemeButton" Content="Export Theme" Click="ExportThemeButton_Click" />
                        <Button x:Name="DeleteThemeButton" Content="Delete User Theme" Click="DeleteThemeButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ImportExportStatus" Text="" FontSize="{StaticResource AvexTypeBody}"
                               Foreground="{ThemeResource AvexTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Available Themes Section -->
            <StackPanel Spacing="{StaticResource AvexSpaceSm}">
                <TextBlock Text="Available Themes" FontSize="{StaticResource AvexTypeH3}" FontWeight="SemiBold"
                           Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                <TextBlock Text="Select a theme to apply to the control center. User themes override built-in themes with the same ID." FontSize="{StaticResource AvexTypeBody}"
                           Foreground="{ThemeResource AvexTextTertiaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource AvexSurface1Brush}"
                    BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AvexCardCornerRadius}"
                    Padding="{StaticResource AvexSpaceLg}">
                <StackPanel Spacing="{StaticResource AvexSpaceMd}">
                    <ListView x:Name="ThemeList" MaxHeight="320" SelectionMode="Single"
                              SelectionChanged="ThemeList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceSm}">
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource AvexTypeBodyLg}"
                                                   FontWeight="SemiBold" Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Source}" FontSize="{StaticResource AvexTypeCaption}"
                                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="{StaticResource AvexTypeBody}"
                                               Foreground="{ThemeResource AvexTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Height="1" Background="{ThemeResource AvexBorderSubtleBrush}" Margin="0,4" />

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceSm}">
                        <Button x:Name="PreviewThemeButton" Content="Preview" Click="PreviewThemeButton_Click" />
                        <Button x:Name="ApplyThemeButton" Content="Apply to Control Center" Click="ApplyThemeButton_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="" FontSize="{StaticResource AvexTypeBody}"
                               Foreground="{ThemeResource AvexTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Theme Preview Area -->
            <Border x:Name="PreviewBorder" Background="{ThemeResource AvexSurface1Brush}"
                    BorderBrush="{ThemeResource AvexBorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource AvexCardCornerRadius}"
                    Padding="{StaticResource AvexSpaceLg}" Visibility="Collapsed">
                <StackPanel Spacing="{StaticResource AvexSpaceMd}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceMd}">
                        <TextBlock Text="Theme Preview" FontSize="{StaticResource AvexTypeH3}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PreviewThemeName" Text="" FontSize="{StaticResource AvexTypeBody}"
                                   Foreground="{ThemeResource AvexTextSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Content="Close Preview" Click="ClosePreviewButton_Click" HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- Color Swatches -->
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="Color Palette" FontSize="{StaticResource AvexTypeBodyLg}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextSecondaryBrush}" />
                        <StackPanel x:Name="ColorSwatchPanel" Orientation="Horizontal" Spacing="{StaticResource AvexSpaceXs}" />
                    </StackPanel>

                    <!-- Sample UI Elements -->
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="Sample Elements" FontSize="{StaticResource AvexTypeBodyLg}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextSecondaryBrush}" />
                        <Border x:Name="PreviewSurface" CornerRadius="3" Padding="{StaticResource AvexSpaceMd}"
                                BorderBrush="{ThemeResource AvexBorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="{StaticResource AvexSpaceXs}" MaxWidth="400" HorizontalAlignment="Left">
                                <TextBlock x:Name="PreviewTitle" Text="Preview Title Text" FontSize="{StaticResource AvexTypeH2}" FontWeight="SemiBold" />
                                <TextBlock x:Name="PreviewBody" Text="This is how body text will appear with the selected theme applied to the control center."
                                           TextWrapping="Wrap" FontSize="{StaticResource AvexTypeBody}" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceXs}">
                                    <Button x:Name="PreviewPrimaryBtn" Content="Primary" Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="PreviewSecondaryBtn" Content="Secondary" />
                                </StackPanel>
                                <ProgressBar x:Name="PreviewProgress" Value="65" Width="200" HorizontalAlignment="Left" />
                                <ToggleSwitch x:Name="PreviewToggle" Header="Sample Toggle" IsOn="True" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Theme Scheduler Section -->
            <StackPanel Spacing="{StaticResource AvexSpaceSm}">
                <TextBlock Text="Theme Scheduler" FontSize="{StaticResource AvexTypeH3}" FontWeight="SemiBold"
                           Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                <TextBlock Text="Automatically switch themes at scheduled times" FontSize="{StaticResource AvexTypeBody}"
                           Foreground="{ThemeResource AvexTextTertiaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource AvexSurface1Brush}"
                    BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AvexCardCornerRadius}"
                    Padding="{StaticResource AvexSpaceLg}">
                <StackPanel Spacing="{StaticResource AvexSpaceMd}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceMd}">
                        <TextBlock Text="Enable Scheduler" FontSize="{StaticResource AvexTypeBodyLg}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextPrimaryBrush}" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="SchedulerToggle" Toggled="SchedulerToggle_Toggled" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceSm}">
                        <TimePicker x:Name="ScheduleTimePicker" ClockIdentifier="24HourClock" />
                        <ComboBox x:Name="ScheduleThemeCombo" PlaceholderText="Select theme" Width="180" />
                        <ComboBox x:Name="ScheduleModeCombo" Width="100" SelectedIndex="0">
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                        </ComboBox>
                        <Button Content="Add" Click="AddScheduleButton_Click" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource AvexBorderSubtleBrush}" Margin="0,4" />

                    <ListView x:Name="ScheduleList" MaxHeight="200" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceMd}">
                                    <TextBlock Text="{Binding TimeDisplay}" Width="60" VerticalAlignment="Center"
                                               FontSize="{StaticResource AvexTypeBodyLg}" Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding ThemeName}" Width="160" VerticalAlignment="Center"
                                               FontSize="{StaticResource AvexTypeBody}" Foreground="{ThemeResource AvexTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Mode}" Width="50" VerticalAlignment="Center"
                                               FontSize="{StaticResource AvexTypeBody}" Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                                    <Button Content="Delete" Tag="{Binding Id}" Click="DeleteScheduleButton_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- AI Design Studio Section -->
            <StackPanel Spacing="{StaticResource AvexSpaceSm}">
                <TextBlock Text="AI Design Studio" FontSize="{StaticResource AvexTypeH3}" FontWeight="SemiBold"
                           Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                <TextBlock Text="Generate custom theme proposals using natural language descriptions" FontSize="{StaticResource AvexTypeBody}"
                           Foreground="{ThemeResource AvexTextTertiaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource AvexSurface1Brush}"
                    BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AvexCardCornerRadius}"
                    Padding="{StaticResource AvexSpaceLg}">
                <StackPanel Spacing="{StaticResource AvexSpaceMd}">
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="PROMPT" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <TextBlock Text="Describe the theme you want to create" FontSize="{StaticResource AvexTypeBody}"
                                   Foreground="{ThemeResource AvexTextSecondaryBrush}" />
                    </StackPanel>

                    <TextBox x:Name="PromptBox" PlaceholderText="e.g., Create a dark graphite theme for programming"
                             TextWrapping="Wrap" AcceptsReturn="False" MinHeight="60" />

                    <Button Content="Generate Proposal" Click="GenerateButton_Click"
                            Style="{StaticResource AccentButtonStyle}" />

                    <TextBlock x:Name="ProposalStatus" Text="" FontSize="{StaticResource AvexTypeBody}"
                               Foreground="{ThemeResource AvexTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
