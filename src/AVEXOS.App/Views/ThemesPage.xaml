<Page
    x:Class="AVEXOS.App.ThemesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="16">
            <TextBlock Text="Themes" FontSize="20" FontWeight="SemiBold" />
            <Border Background="{ThemeResource AvexSurface1Brush}" CornerRadius="3" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Built-in Themes" FontSize="16" FontWeight="SemiBold" />
                    <ListView x:Name="ThemeList" MaxHeight="300" SelectionMode="Single"
                              SelectionChanged="ThemeList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Foreground="{ThemeResource AvexTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Name="ApplyThemeButton" Content="Apply to Control Center" Click="ApplyThemeButton_Click" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource AvexSurface1Brush}" CornerRadius="3" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="AI Design Studio (Local)" FontSize="16" FontWeight="SemiBold" />
                    <TextBox x:Name="PromptBox" PlaceholderText="e.g., Create a dark graphite theme for programming" />
                    <Button Content="Generate Proposal" Click="GenerateButton_Click" />
                    <TextBlock x:Name="ProposalStatus" Text="" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
