<Page
    x:Class="AVEXOS.App.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="{StaticResource AvexPaddingLg}">
        <StackPanel Spacing="{StaticResource AvexSpaceLg}">

            <!-- Page Header -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceMd}">
                <Image Source="ms-appx:///assets/avex-logo.jpeg" Width="48" Height="48" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Appearance" FontSize="{StaticResource AvexTypeH2}" FontWeight="SemiBold"
                               Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                    <TextBlock Text="Customize the look and feel of the AVEX OS desktop" FontSize="{StaticResource AvexTypeBody}"
                               Foreground="{ThemeResource AvexTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Multi-Monitor Selector Section -->
            <StackPanel Spacing="{StaticResource AvexSpaceSm}">
                <TextBlock Text="Monitor Selection" FontSize="{StaticResource AvexTypeH3}" FontWeight="SemiBold"
                           Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                <TextBlock Text="Select a monitor to configure its wallpaper independently" FontSize="{StaticResource AvexTypeBody}"
                           Foreground="{ThemeResource AvexTextTertiaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource AvexSurface1Brush}"
                    BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AvexCardCornerRadius}"
                    Padding="{StaticResource AvexPaddingLg}">
                <StackPanel Spacing="{StaticResource AvexSpaceMd}">

                    <!-- Monitor dropdown -->
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="ACTIVE MONITOR" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <ComboBox x:Name="MonitorSelector" Width="320" SelectionChanged="MonitorSelector_SelectionChanged"
                                  HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Monitor info display -->
                    <StackPanel x:Name="MonitorInfoPanel" Spacing="{StaticResource AvexSpaceXxs}" Visibility="Collapsed">
                        <TextBlock Text="MONITOR DETAILS" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <TextBlock x:Name="MonitorDetails" Text=""
                                   FontSize="{StaticResource AvexTypeBody}"
                                   Foreground="{ThemeResource AvexTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Monitor preview -->
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="WALLPAPER PREVIEW" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <Border x:Name="PreviewBorder" Width="320" Height="180"
                                BorderBrush="{ThemeResource AvexBorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="4" Background="{ThemeResource AvexSurface2Brush}"
                                HorizontalAlignment="Left">
                            <Image x:Name="WallpaperPreview" Stretch="UniformToFill" />
                        </Border>
                    </StackPanel>

                    <!-- Current wallpaper for selected monitor -->
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="CURRENT WALLPAPER (THIS MONITOR)" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <TextBlock x:Name="CurrentWallpaper" Text="Loading..."
                                   FontSize="{StaticResource AvexTypeBodyLg}"
                                   Foreground="{ThemeResource AvexTextPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Separator -->
                    <Border Height="1" Background="{ThemeResource AvexBorderSubtleBrush}" Margin="0,4" />

                    <!-- Actions -->
                    <StackPanel Spacing="{StaticResource AvexSpaceXs}">
                        <TextBlock Text="Actions" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceSm}" Margin="0,4,0,0">
                            <Button x:Name="ApplyButton" Content="Apply AVEX Wallpaper" Click="ApplyButton_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="ApplyToAllButton" Content="Apply to All Monitors" Click="ApplyToAllButton_Click" />
                            <Button x:Name="RestoreButton" Content="Restore Original" Click="RestoreButton_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Status feedback -->
                    <TextBlock x:Name="StatusText" Text="" FontSize="{StaticResource AvexTypeBody}"
                               Foreground="{ThemeResource AvexTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Custom Color Accent Picker -->
            <StackPanel Spacing="{StaticResource AvexSpaceSm}">
                <TextBlock Text="Custom Accent Color" FontSize="{StaticResource AvexTypeH3}" FontWeight="SemiBold"
                           Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                <TextBlock Text="Pick a custom accent color and preview it on sample elements" FontSize="{StaticResource AvexTypeBody}"
                           Foreground="{ThemeResource AvexTextTertiaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource AvexSurface1Brush}"
                    BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AvexCardCornerRadius}"
                    Padding="{StaticResource AvexPaddingLg}">
                <StackPanel Spacing="{StaticResource AvexSpaceMd}">

                    <!-- Color input -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceSm}" VerticalAlignment="Center">
                        <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                            <TextBlock Text="ACCENT COLOR (HEX)" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                            <TextBox x:Name="AccentHexInput" PlaceholderText="#6E8BFF" Width="120"
                                     TextChanged="AccentHexInput_TextChanged" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom" Spacing="{StaticResource AvexSpaceXs}">
                            <Border x:Name="AccentPreviewBorder" Width="48" Height="48" CornerRadius="3"
                                    Background="#6E8BFF" BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                                    BorderThickness="1" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Preset accent colors -->
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="PRESETS" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceXs}">
                            <Button Tag="#6E8BFF" Click="PresetAccent_Click" Padding="0" Width="36" Height="36"
                                    Background="#6E8BFF" CornerRadius="3" />
                            <Button Tag="#3FA96B" Click="PresetAccent_Click" Padding="0" Width="36" Height="36"
                                    Background="#3FA96B" CornerRadius="3" />
                            <Button Tag="#D9A23A" Click="PresetAccent_Click" Padding="0" Width="36" Height="36"
                                    Background="#D9A23A" CornerRadius="3" />
                            <Button Tag="#D9534F" Click="PresetAccent_Click" Padding="0" Width="36" Height="36"
                                    Background="#D9534F" CornerRadius="3" />
                            <Button Tag="#9B59B6" Click="PresetAccent_Click" Padding="0" Width="36" Height="36"
                                    Background="#9B59B6" CornerRadius="3" />
                            <Button Tag="#1ABC9C" Click="PresetAccent_Click" Padding="0" Width="36" Height="36"
                                    Background="#1ABC9C" CornerRadius="3" />
                            <Button Tag="#E74C3C" Click="PresetAccent_Click" Padding="0" Width="36" Height="36"
                                    Background="#E74C3C" CornerRadius="3" />
                            <Button Tag="#F39C12" Click="PresetAccent_Click" Padding="0" Width="36" Height="36"
                                    Background="#F39C12" CornerRadius="3" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Preview with custom accent -->
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="PREVIEW" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <Border x:Name="AccentPreviewSurface" CornerRadius="3" Padding="{StaticResource AvexPaddingMd}"
                                BorderBrush="{ThemeResource AvexBorderSubtleBrush}" BorderThickness="1"
                                Background="{ThemeResource AvexSurface2Brush}">
                            <StackPanel Spacing="{StaticResource AvexSpaceXs}" MaxWidth="360">
                                <TextBlock Text="Sample heading with custom accent" FontSize="{StaticResource AvexTypeH3}"
                                           FontWeight="SemiBold" x:Name="AccentPreviewTitle" />
                                <TextBlock Text="Body text preview showing how the accent color affects buttons and highlights."
                                           TextWrapping="Wrap" FontSize="{StaticResource AvexTypeBody}" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceXs}">
                                    <Button x:Name="AccentPreviewButton" Content="Accent Button" />
                                    <ProgressBar x:Name="AccentPreviewProgress" Value="70" Width="160" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Save button -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceSm}">
                        <Button Content="Save as Custom Theme" Click="SaveCustomAccent_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock x:Name="AccentStatusText" Text="" FontSize="{StaticResource AvexTypeBody}"
                                   Foreground="{ThemeResource AvexTextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Wallpaper Slideshow -->
            <StackPanel Spacing="{StaticResource AvexSpaceSm}">
                <TextBlock Text="Wallpaper Slideshow" FontSize="{StaticResource AvexTypeH3}" FontWeight="SemiBold"
                           Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                <TextBlock Text="Configure automatic wallpaper rotation for the selected monitor" FontSize="{StaticResource AvexTypeBody}"
                           Foreground="{ThemeResource AvexTextTertiaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource AvexSurface1Brush}"
                    BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AvexCardCornerRadius}"
                    Padding="{StaticResource AvexPaddingLg}">
                <StackPanel Spacing="{StaticResource AvexSpaceMd}">

                    <!-- Slideshow toggle -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceMd}">
                        <TextBlock Text="Enable Slideshow" FontSize="{StaticResource AvexTypeBodyLg}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextPrimaryBrush}" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="SlideshowToggle" Toggled="SlideshowToggle_Toggled" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Interval selector -->
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="ROTATION INTERVAL" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <ComboBox x:Name="SlideshowIntervalCombo" Width="200" SelectionChanged="SlideshowInterval_SelectionChanged">
                            <ComboBoxItem Content="Every 15 minutes" Tag="15" />
                            <ComboBoxItem Content="Every 30 minutes" Tag="30" />
                            <ComboBoxItem Content="Every 1 hour" Tag="60" />
                            <ComboBoxItem Content="Every 4 hours" Tag="240" />
                            <ComboBoxItem Content="Every day" Tag="1440" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Wallpaper list for this monitor -->
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="SLIDESHOW WALLPAPERS" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <ListView x:Name="SlideshowWallpaperList" MaxHeight="200" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="{StaticResource AvexTypeBody}"
                                               Foreground="{ThemeResource AvexTextPrimaryBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- Add/Remove buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceSm}">
                        <Button Content="Add Wallpaper..." Click="AddSlideshowWallpaper_Click" />
                        <Button Content="Remove Selected" Click="RemoveSlideshowWallpaper_Click" />
                        <Button Content="Advance Now" Click="AdvanceSlideshow_Click" />
                    </StackPanel>

                    <TextBlock x:Name="SlideshowStatusText" Text="" FontSize="{StaticResource AvexTypeBody}"
                               Foreground="{ThemeResource AvexTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
