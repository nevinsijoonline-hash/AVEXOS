<Page
    x:Class="AVEXOS.App.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Image Source="ms-appx:///assets/avex-logo.jpeg" Width="48" Height="48" />
                <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Border Background="{ThemeResource AvexSurface1Brush}" CornerRadius="3" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Desktop Wallpaper" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="CurrentWallpaper" Text="Loading..." Foreground="{ThemeResource AvexTextSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="ApplyButton" Content="Apply AVEX Wallpaper" Click="ApplyButton_Click" />
                        <Button x:Name="RestoreButton" Content="Restore Original" Click="RestoreButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
