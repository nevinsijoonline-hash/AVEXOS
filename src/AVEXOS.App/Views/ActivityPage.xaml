<Page
    x:Class="AVEXOS.App.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="{StaticResource AvexPaddingLg}">
        <StackPanel Spacing="{StaticResource AvexSpaceLg}">

            <!-- Page Header -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceMd}">
                <Image Source="ms-appx:///assets/avex-logo.jpeg" Width="48" Height="48" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Activity" FontSize="{StaticResource AvexTypeH2}" FontWeight="SemiBold"
                               Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                    <TextBlock Text="Chronological log of all system events and operations" FontSize="{StaticResource AvexTypeBody}"
                               Foreground="{ThemeResource AvexTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Activity Log -->
            <StackPanel Spacing="{StaticResource AvexSpaceSm}">
                <TextBlock Text="Event Log" FontSize="{StaticResource AvexTypeH3}" FontWeight="SemiBold"
                           Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                <TextBlock Text="All recorded activities in reverse chronological order" FontSize="{StaticResource AvexTypeBody}"
                           Foreground="{ThemeResource AvexTextTertiaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource AvexSurface1Brush}"
                    BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AvexCardCornerRadius}"
                    Padding="{StaticResource AvexPaddingMd}">
                <ListView x:Name="ActivityList" MaxHeight="600">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="BorderBrush" Value="{ThemeResource AvexBorderSubtleBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="{StaticResource AvexSpaceMd}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Utc}" FontSize="{StaticResource AvexTypeCaption}"
                                           Foreground="{ThemeResource AvexTextTertiaryBrush}" VerticalAlignment="Top"
                                           FontFamily="Consolas" />

                                <StackPanel Grid.Column="1" Spacing="{StaticResource AvexSpaceXxs}">
                                    <TextBlock Text="{Binding Category}" FontSize="{StaticResource AvexTypeBodyLg}"
                                               FontWeight="SemiBold" Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="{StaticResource AvexTypeBody}"
                                               Foreground="{ThemeResource AvexTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
