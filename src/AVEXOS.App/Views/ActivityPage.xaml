<Page
    x:Class="AVEXOS.App.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Image Source="ms-appx:///assets/avex-logo.jpeg" Width="48" Height="48" />
                <TextBlock Text="Activity" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <ListView x:Name="ActivityList" MaxHeight="600">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Utc}" FontSize="11" Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                            <TextBlock Text="{Binding Category}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource AvexTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
