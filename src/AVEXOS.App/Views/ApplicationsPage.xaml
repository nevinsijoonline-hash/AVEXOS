<Page
    x:Class="AVEXOS.App.ApplicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Applications" FontSize="20" FontWeight="SemiBold" />
                <Button Content="Refresh" Click="RefreshButton_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="Loading..." Foreground="{ThemeResource AvexTextSecondaryBrush}" />
            <ListView x:Name="AppList" MaxHeight="600">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Publisher}" Foreground="{ThemeResource AvexTextSecondaryBrush}" />
                            <TextBlock Text="{Binding CapabilityReason}" Foreground="{ThemeResource AvexTextTertiaryBrush}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
