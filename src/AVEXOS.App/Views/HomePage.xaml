<Page
    x:Class="AVEXOS.App.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="16">
            <TextBlock Text="AVEX OS" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Control Center" FontSize="16" Foreground="{ThemeResource AvexTextSecondaryBrush}" />
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Column="0" Grid.Row="0" Background="{ThemeResource AvexSurface1Brush}" CornerRadius="3" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Theme" FontSize="12" Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                        <TextBlock x:Name="ThemeName" Text="—" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Grid.Row="0" Background="{ThemeResource AvexSurface1Brush}" CornerRadius="3" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Mode" FontSize="12" Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                        <TextBlock x:Name="ThemeMode" Text="—" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Grid.Row="0" Background="{ThemeResource AvexSurface1Brush}" CornerRadius="3" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Windows" FontSize="12" Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                        <TextBlock x:Name="WindowsBuild" Text="—" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Grid.Row="0" Background="{ThemeResource AvexSurface1Brush}" CornerRadius="3" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Applications" FontSize="12" Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                        <TextBlock x:Name="AppCount" Text="0" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="0" Grid.Row="1" Background="{ThemeResource AvexSurface1Brush}" CornerRadius="3" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Supported" FontSize="12" Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                        <TextBlock x:Name="SupportedCount" Text="0" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Grid.Row="1" Background="{ThemeResource AvexSurface1Brush}" CornerRadius="3" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Backups" FontSize="12" Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                        <TextBlock x:Name="BackupCount" Text="0" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Grid.Row="1" Background="{ThemeResource AvexSurface1Brush}" CornerRadius="3" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Pending" FontSize="12" Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                        <TextBlock x:Name="PendingCount" Text="0" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="Recent Activity" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ListView x:Name="ActivityList" MaxHeight="300">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Category}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource AvexTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
