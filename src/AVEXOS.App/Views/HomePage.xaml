<Page
    x:Class="AVEXOS.App.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="{StaticResource AvexPaddingLg}">
        <StackPanel Spacing="{StaticResource AvexSpaceLg}">

            <!-- Page Header -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AvexSpaceMd}">
                <Image Source="ms-appx:///assets/avex-logo.jpeg" Width="56" Height="56" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="AVEX OS" FontSize="{StaticResource AvexTypeDisplay}" FontWeight="SemiBold" Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                    <TextBlock Text="Control Center — System overview and quick status" FontSize="{StaticResource AvexTypeBodyLg}" Foreground="{ThemeResource AvexTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- System Information Section -->
            <StackPanel Spacing="{StaticResource AvexSpaceXs}">
                <TextBlock Text="System Information" FontSize="{StaticResource AvexTypeH3}" FontWeight="SemiBold" Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                <TextBlock Text="Current configuration and environment details" FontSize="{StaticResource AvexTypeBody}" Foreground="{ThemeResource AvexTextTertiaryBrush}" />
            </StackPanel>

            <!-- Stats Grid -->
            <Grid ColumnSpacing="{StaticResource AvexSpaceMd}" RowSpacing="{StaticResource AvexSpaceMd}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.Row="0"
                        Background="{ThemeResource AvexSurface1Brush}"
                        BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AvexCardCornerRadius}"
                        Padding="{StaticResource AvexPaddingLg}">
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="THEME" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <TextBlock x:Name="ThemeName" Text="—" FontSize="{StaticResource AvexTypeH2}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Grid.Row="0"
                        Background="{ThemeResource AvexSurface1Brush}"
                        BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AvexCardCornerRadius}"
                        Padding="{StaticResource AvexPaddingLg}">
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="MODE" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <TextBlock x:Name="ThemeMode" Text="—" FontSize="{StaticResource AvexTypeH2}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Grid.Row="0"
                        Background="{ThemeResource AvexSurface1Brush}"
                        BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AvexCardCornerRadius}"
                        Padding="{StaticResource AvexPaddingLg}">
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="WINDOWS BUILD" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <TextBlock x:Name="WindowsBuild" Text="—" FontSize="{StaticResource AvexTypeH2}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Grid.Row="0"
                        Background="{ThemeResource AvexSurface1Brush}"
                        BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AvexCardCornerRadius}"
                        Padding="{StaticResource AvexPaddingLg}">
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="APPLICATIONS" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <TextBlock x:Name="AppCount" Text="0" FontSize="{StaticResource AvexTypeH2}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="0" Grid.Row="1"
                        Background="{ThemeResource AvexSurface1Brush}"
                        BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AvexCardCornerRadius}"
                        Padding="{StaticResource AvexPaddingLg}">
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="SUPPORTED" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <TextBlock x:Name="SupportedCount" Text="0" FontSize="{StaticResource AvexTypeH2}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Grid.Row="1"
                        Background="{ThemeResource AvexSurface1Brush}"
                        BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AvexCardCornerRadius}"
                        Padding="{StaticResource AvexPaddingLg}">
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="BACKUPS" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <TextBlock x:Name="BackupCount" Text="0" FontSize="{StaticResource AvexTypeH2}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Grid.Row="1"
                        Background="{ThemeResource AvexSurface1Brush}"
                        BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AvexCardCornerRadius}"
                        Padding="{StaticResource AvexPaddingLg}">
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="PENDING" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <TextBlock x:Name="PendingCount" Text="0" FontSize="{StaticResource AvexTypeH2}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Grid.Row="1"
                        Background="{ThemeResource AvexSurface1Brush}"
                        BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AvexCardCornerRadius}"
                        Padding="{StaticResource AvexPaddingLg}">
                    <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                        <TextBlock Text="SESSION" FontSize="{StaticResource AvexTypeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextTertiaryBrush}" CharacterSpacing="80" />
                        <TextBlock x:Name="SessionDuration" Text="0s" FontSize="{StaticResource AvexTypeH2}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Detailed System Information Dashboard -->
            <Border Background="{ThemeResource AvexSurface1Brush}"
                    BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AvexCardCornerRadius}"
                    Padding="{StaticResource AvexPaddingLg}">
                <StackPanel Spacing="{StaticResource AvexSpaceSm}">
                    <TextBlock Text="System Information" FontSize="{StaticResource AvexTypeH3}" FontWeight="SemiBold"
                               Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                    <Grid ColumnSpacing="{StaticResource AvexSpaceXl}" RowSpacing="{StaticResource AvexSpaceXs}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                            <TextBlock Text="Windows Version" FontSize="{StaticResource AvexTypeCaption}"
                                       Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                            <TextBlock x:Name="SysWindowsVersion" Text="—" FontSize="{StaticResource AvexTypeBody}"
                                       Foreground="{ThemeResource AvexTextPrimaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                            <TextBlock Text=".NET Runtime" FontSize="{StaticResource AvexTypeCaption}"
                                       Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                            <TextBlock x:Name="SysDotNetVersion" Text="—" FontSize="{StaticResource AvexTypeBody}"
                                       Foreground="{ThemeResource AvexTextPrimaryBrush}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                            <TextBlock Text="AVEX OS Version" FontSize="{StaticResource AvexTypeCaption}"
                                       Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                            <TextBlock x:Name="SysAppVersion" Text="—" FontSize="{StaticResource AvexTypeBody}"
                                       Foreground="{ThemeResource AvexTextPrimaryBrush}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                            <TextBlock Text="Current Theme" FontSize="{StaticResource AvexTypeCaption}"
                                       Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                            <TextBlock x:Name="SysThemeId" Text="—" FontSize="{StaticResource AvexTypeBody}"
                                       Foreground="{ThemeResource AvexTextPrimaryBrush}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
                            <TextBlock Text="Theme Mode" FontSize="{StaticResource AvexTypeCaption}"
                                       Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                            <TextBlock x:Name="SysThemeMode" Text="—" FontSize="{StaticResource AvexTypeBody}"
                                       Foreground="{ThemeResource AvexTextPrimaryBrush}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                            <TextBlock Text="Active Wallpaper" FontSize="{StaticResource AvexTypeCaption}"
                                       Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                            <TextBlock x:Name="SysWallpaperPath" Text="—" FontSize="{StaticResource AvexTypeBody}"
                                       Foreground="{ThemeResource AvexTextPrimaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Spacing="2">
                            <TextBlock Text="Machine" FontSize="{StaticResource AvexTypeCaption}"
                                       Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                            <TextBlock x:Name="SysMachineName" Text="—" FontSize="{StaticResource AvexTypeBody}"
                                       Foreground="{ThemeResource AvexTextPrimaryBrush}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
                            <TextBlock Text="User" FontSize="{StaticResource AvexTypeCaption}"
                                       Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                            <TextBlock x:Name="SysUserName" Text="—" FontSize="{StaticResource AvexTypeBody}"
                                       Foreground="{ThemeResource AvexTextPrimaryBrush}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="0" Spacing="2">
                            <TextBlock Text="Processors" FontSize="{StaticResource AvexTypeCaption}"
                                       Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                            <TextBlock x:Name="SysProcessorCount" Text="—" FontSize="{StaticResource AvexTypeBody}"
                                       Foreground="{ThemeResource AvexTextPrimaryBrush}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
                            <TextBlock Text="Available Memory" FontSize="{StaticResource AvexTypeCaption}"
                                       Foreground="{ThemeResource AvexTextTertiaryBrush}" />
                            <TextBlock x:Name="SysTotalMemory" Text="—" FontSize="{StaticResource AvexTypeBody}"
                                       Foreground="{ThemeResource AvexTextPrimaryBrush}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Recent Activity Section -->
            <StackPanel Spacing="{StaticResource AvexSpaceXs}">
                <TextBlock Text="Recent Activity" FontSize="{StaticResource AvexTypeH3}" FontWeight="SemiBold"
                           Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                <TextBlock Text="Latest system events and operations" FontSize="{StaticResource AvexTypeBody}"
                           Foreground="{ThemeResource AvexTextTertiaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource AvexSurface1Brush}"
                    BorderBrush="{ThemeResource AvexBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AvexCardCornerRadius}"
                    Padding="{StaticResource AvexPaddingMd}">
                <ListView x:Name="ActivityList" MaxHeight="320">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="{StaticResource AvexSpaceXxs}">
                                <TextBlock Text="{Binding Category}" FontSize="{StaticResource AvexTypeBodyLg}"
                                           FontWeight="SemiBold" Foreground="{ThemeResource AvexTextPrimaryBrush}" />
                                <TextBlock Text="{Binding Detail}" FontSize="{StaticResource AvexTypeBody}"
                                           Foreground="{ThemeResource AvexTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
